{
  "permissions": {
    "allow": [
      "PowerShell(*)",
      "Bash(git init)",
      "Bash(git switch:*)",
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq . > tool-use.json"
          },
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_input.file_path' tool-use.json) && [[ \"$fp\" =~ \\.tsx?$ ]] && npx prettier --write \"$fp\" || true"
          }
        ]
      }
    ]
  }
}